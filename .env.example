# Environment variables — copy to .env and fill in real values

# ── Firebase ──────────────────────────────────────────────────────────────────
# Path to the Firebase service account JSON key (Project settings → Service accounts → Generate new private key)
# Save the file as backend/firebase-service-account.json (git-ignored).
FIREBASE_SERVICE_ACCOUNT_FILE=./firebase-service-account.json

# ── Groq (AI bullet improvements — free tier at console.groq.com) ─────────────
GROQ_API_KEY=your-groq-api-key-here
# Optional: override the model (default openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b

# ── Legacy SQL settings (unused — data now lives in Firestore) ────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/ats_db
SECRET_KEY=change-this-to-a-random-32-character-string-in-production

# Frontend URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# JSON list of frontend origins the backend allows (CORS)
ALLOWED_ORIGINS=["http://localhost:3000"]
